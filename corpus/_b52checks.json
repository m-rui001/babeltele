  "single": [
   "# -08/-07 - PST/PDT (North America DST)",
   "# -08/-07 - PST/PDT (North America DST) until 2026-11-01 02:00; then MST",
   "# -10/-09 - HST / HDT (North America DST)",
   "# 2.  The first column is irrelevant and ignored.",
   "# 3.  The table is sorted in a different way:",
   "# 4.  Every timezone has a nonempty comments column, with wording",
   "# From Paul Eggert (2023-12-18):",
   "# The format of this table is experimental, and may change in future versions.",
   "# civil timestamps have agreed since 1970.  Columns are separated by",
   "# where civil timestamps are predicted to agree from now on.",
   "#XX\tcoordinates\tTZ\tcomments",
   "(Morocco DST)",
   "+10:30/+11",
   "-v now=$$now",
   "-v now_out=$@.out",
   "-v zdump_table=$@d/zdump-now.tab \\",
   "./zic -d $@d tzdata.zi",
   "CHECK_NOW_TIMESTAMP = $$(./date +%s)",
   "CI,BF,GH,GM,GN,IS,ML,MR,SH,SL,SN,TG\t+0519-00402\tAfrica/Abidjan",
   "CST/CDT",
   "Central Standard (CST) - Alberta, NWT, and some neighbors",
   "Eastern Standard (EST) - Manitoba, northwestern Ontario",
   "FS = \"\\t\"",
   "IST/GMT (EU DST in reverse)",
   "MST/MDT",
   "Mountain Standard (MST) - British Columbia (most areas)",
   "New Zealand (NZST/NZDT)",
   "PR,AG,CA,AI,AW,BL,BQ,CW,DM,GD,GP,KN,LC,MF,MS,SX,TT,VC,VG,VI\t+182806-0660622\tAmerica/Puerto_Rico\tAST - QC (Lower North Shore)",
   "PST/PDT",
   "Samoa (western)",
   "Troll DST",
   "agree from now on",
   "mkdir $@d",
   "mv $@.out $@",
   "now.ck: checknow.awk date tzdata.zi zdump zic zone1970.tab zonenow.tab",
   "printf \"%s: no data\\n\", zone",
   "printf \"%s=%s\\n\", now, zones[data] >>now_out",
   "printf \"Zone table should have one of:%s\\n\", zones[data]",
   "printf \"zones %s and %s identical from now on\\n\", zone, zone2",
   "rm -fr $@d",
   "while (getline <zdump_table) {",
   "zone = $3",
   "zonenow[data] = zone # This suppresses duplicate diagnostics."
